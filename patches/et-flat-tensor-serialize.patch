 )
 
+# .ptd WRITER. MergedDataMap backs the Module(pte, {ptd, ...}) constructor, so a consumer that
+# reads more than one external-data file needs this header installed next to the library.
+install(
+  FILES merged_data_map.h
+  DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/executorch/extension/named_data_map
+)
+
 # Add tests if testing is enabled
 if(BUILD_TESTING)
   add_subdirectory(test)
